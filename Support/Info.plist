<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>LocalFlow</string>
	<key>CFBundleExecutable</key>
	<string>LocalFlow</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>ai.xdlab.LocalFlow</string>
	<key>CFBundleName</key>
	<string>LocalFlow</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.1</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Turn a swallowed exception into an actual crash report. AppKit catches
	     uncaught NSExceptions in the main event loop and carries on, leaving the
	     app running in an undefined state with NOTHING written to
	     ~/Library/Logs/DiagnosticReports — so the failure is invisible to the
	     user, to the crash prompt, and to us. Crashing is the honest outcome:
	     the Cocoa frameworks are not exception-safe, so "carried on" is a
	     fiction. See CrashReports.swift. -->
	<key>NSApplicationCrashOnExceptions</key>
	<true/>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>LocalFlow records your voice while you hold the push-to-talk key so it can transcribe it locally. Audio never leaves this Mac.</string>
</dict>
</plist>
